#!/usr/bin/env bash
# Configures /etc/hosts so localhost resolves to 127.0.0.2 and facebook.com resolves to 8.8.8.8

# Replace 127.0.0.1 with 127.0.0.2 for localhost
sed -i 's/127\.0\.0\.1/127.0.0.2/g' /etc/hosts

# Remove any existing facebook.com mapping to prevent duplicates
sed -i '/facebook.com/d' /etc/hosts

# Append the new facebook.com mapping
echo "8.8.8.8 facebook.com" >> /etc/hosts
